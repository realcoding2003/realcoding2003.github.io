---
import { portalCopy } from '../../lib/portal-copy';
import { prefix } from '../../lib/site.mjs';
import WorkImage from './WorkImage.astro';
import LineIcon from './LineIcon.astro';
interface Props { lang: string }
const { lang } = Astro.props; const t = portalCopy[lang];
---
<section class="portal-section container--wide" data-layer="6" aria-labelledby="together-title"><div class="diptych" data-reveal>
  <div class="photo" data-ambient data-src-desktop="/assets/video/portal/request-desktop.mp4" data-src-mobile="/assets/video/portal/request-mobile.mp4"><WorkImage src="/assets/video/portal/request-poster.jpg" alt="" sizes="(min-width:900px) 50vw, 100vw" /></div>
  <div class="yellow"><h2 id="together-title" data-copy>{t['together.title']}</h2><ul>{['print','dev'].map((type) => <li><LineIcon name={type === 'print' ? 'layers' : 'code'} /><a href={`${prefix(lang)}/request/#${type}`} data-copy>{t[`together.${type}`]}</a></li>)}</ul><a class="together-request" href={`${prefix(lang)}/request/`} data-copy>{t.request}</a></div>
  <div class="layer-number" aria-hidden="true"><span>0.20</span><span>0.20</span></div>
</div></section>
<style>
.diptych { position: relative; display: grid; grid-template-columns: 1fr 1fr; min-height: clamp(30rem,42vw,42rem); }
.photo { position: relative; isolation: isolate; min-width: 0; }
.photo :global(picture),.photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.photo::after { content: ''; position: absolute; inset: 0; background: rgb(12 17 48 / .35); }
.yellow { min-width: 0; background: var(--accent); color: var(--ink-950); padding: clamp(2rem,4vw,4.5rem); display: flex; flex-direction: column; align-items: flex-end; }
h2 { text-align: right; font-size: clamp(2.25rem,1rem + 4.6vw,6.25rem); font-weight: 800; line-height: 1.02; }
ul { margin: 2rem 0 0; padding: 0; list-style: none; max-width: 100%; }
li { display: flex; align-items: center; gap: 1.25rem; margin-block: .75rem; }
li :global(svg) { width: 2.5rem; height: 2.5rem; flex-shrink: 0; }
li a { border-left: 1px solid var(--ink-950); padding-left: 1.25rem; font: 800 clamp(1.25rem,1rem + 1vw,2.25rem)/1.3 var(--display-font); color: var(--ink-950); text-decoration: none; }
li a:hover { text-decoration: underline; }
.together-request { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; width: 85%; min-height: clamp(4.5rem,7vw,7.5rem); border: 2px solid var(--ink-950); margin-top: auto; padding: .5rem; font: 800 clamp(1.75rem,1rem + 2.6vw,4rem)/1.15 var(--display-font); color: var(--ink-950); text-decoration: none; text-align: center; background-image: repeating-linear-gradient(to top,var(--ink-950) 0 1px,transparent 1px 5px); background-repeat: no-repeat; background-size: 100% 30%; background-position: bottom; }
.together-request:is(:hover,:focus-visible) { background-size: 100% 100%; background-color: var(--ink-950); color: var(--accent); }
.layer-number { position: absolute; left: 50%; top: 55%; transform: translate(-50%,-50%); font: 800 clamp(6rem,2rem + 14vw,16rem)/.8 'Archivo RC Wide',sans-serif; width: max-content; max-width: 100%; white-space: nowrap; pointer-events: none; }
.layer-number span { display: block; color: var(--stone-100); clip-path: inset(0 50% 0 0); }
.layer-number span + span { position: absolute; inset: 0; color: var(--ink-950); clip-path: inset(0 0 0 50%); }
@media(max-width:899px) {
.diptych { grid-template-columns: 1fr; }
.photo { height: 16rem; }
.yellow { min-height: 30rem; padding-top: 5rem; }
h2 { font-size: clamp(2.25rem,7vw,4rem); }
.layer-number { top: 16rem; font-size: clamp(3rem,20vw,8rem); }
.layer-number span { clip-path: inset(0 0 50% 0); }
.layer-number span + span { clip-path: inset(50% 0 0 0); }
.together-request { margin-top: 2rem; }
}
@media(prefers-reduced-motion:no-preference) { .together-request { transition: background-size 260ms,background-color 260ms,color 260ms; } }
</style>
