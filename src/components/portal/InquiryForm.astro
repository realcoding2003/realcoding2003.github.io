---
import { portalCopy } from '../../lib/portal-copy';
import { CONTACT_EMAIL } from '../../lib/site.mjs';
import SubmitBar from './SubmitBar.astro';
import LineIcon from './LineIcon.astro';
interface Props { lang: string }
const { lang } = Astro.props; const t = portalCopy[lang]; const api = import.meta.env.PUBLIC_INQUIRY_API?.trim() || '';
---
<form class="inquiry-form" data-inquiry-form data-type="print" data-api={api} data-contact={CONTACT_EMAIL} action={`mailto:${CONTACT_EMAIL}`} method="get">
  <script type="application/json" data-inquiry-copy set:html={JSON.stringify(t).replace(/</g,'\\u003c')} />
  <h2 data-form-title data-copy>{t['form.title.print']}</h2><p class="form-sub" data-form-sub data-copy>{t['form.sub.print']}</p>
  <p class="error-summary" role="alert" hidden>{t['errors.summary']}</p>
  <fieldset class="type-radios"><legend>{t['form.type']}</legend>{['print','dev','ax'].map(type => <label><input type="radio" name="type" value={type} checked={type === 'print'} required />{t[`tab.${type}`]}</label>)}</fieldset>
  {(['name','email','phone'] as const).map(name => <div class="form-field" data-field={name}><label for={`inquiry-${name}`}>{t[`label.${name}`]}</label><div><input id={`inquiry-${name}`} name={name} type={name === 'phone' ? 'tel' : name === 'email' ? 'email' : 'text'} autocomplete={name === 'phone' ? 'tel' : name} maxlength={name === 'name' ? 50 : name === 'email' ? 254 : 20} placeholder={t[`ph.${name}`]} required={name !== 'phone'} /><p class="field-error" id={`error-${name}`} hidden></p></div></div>)}
  <div class="form-field company-field" data-company-section><label for="inquiry-company" data-copy>{t['label.company']}</label><div><input id="inquiry-company" name="company" type="text" autocomplete="organization" maxlength="100" placeholder={t['ph.company']} disabled /></div></div>
  <div class="message-field" data-field="message"><label for="inquiry-message">{t['label.message']}</label><textarea id="inquiry-message" name="message" rows="6" maxlength="5000" placeholder={t['ph.message.print']} required></textarea><p class="field-error" id="error-message" hidden></p></div>
  <div data-file-section data-field="files"><label class="file-drop" data-file-drop><input class="sr-only" type="file" id="inquiry-files" name="files" multiple accept=".3mf,.stl" /><LineIcon name="upload" /><strong>{t['file.drop']}</strong><span>{t['file.pick']}</span></label><ul class="file-list" data-file-list></ul><p class="field-error" id="error-files" hidden></p></div>
  {['required','optional'].map(kind => <div class="consent" data-field={`consent_${kind}`}><input type="checkbox" id={`consent-${kind}`} name={`consent_${kind}`} required={kind === 'required'} aria-describedby={`consent-${kind}-detail`} /><div><label for={`consent-${kind}`}>{t[`consent.${kind}`]}</label><p id={`consent-${kind}-detail`} data-copy>{t[`consent.${kind}Detail`].replace('{retention}',t['consent.retention'])}</p><p class="field-error" id={`error-consent_${kind}`} hidden></p></div><a href="/privacy/">{t['consent.full']}</a></div>)}
  <SubmitBar lang={lang} hidden={!api} />
  {!api && <div class="offline-notice"><p data-copy>{t['form.offline']}</p><button class="mail-button" type="button" data-mail>{t['form.mail']}</button><noscript><a class="mail-link" href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(t['form.mailSubject.print'])}`}>{t['form.mail']}</a></noscript></div>}
  <p class="sr-only" aria-live="polite" data-form-status></p>
</form>
<script>import '../../scripts/inquiry-form';</script>
<style>
.inquiry-form { min-width: 0; padding: clamp(1.5rem,2.5vw,2.5rem); border: 1px solid var(--rule); background: var(--surface); align-self: start; }
h2 { font-size: clamp(1.75rem,1.2rem + 2vw,3rem); font-weight: 800; }
.form-sub { color: var(--fg-muted); margin-bottom: 2rem; }
.form-field { display: grid; grid-template-columns: 8.5rem minmax(0,1fr); gap: 1rem; margin-block: 1.25rem; align-items: start; }
.company-field { display: none; }
.inquiry-form[data-type=ax] .company-field { display: grid; }
label { font-weight: 700; }
.form-field > label { padding-block: .5rem; }
input:not([type=checkbox],[type=radio],[type=file]),textarea { background: var(--ink-950); color: var(--fg); border: 1px solid var(--rule); border-radius: 2px; padding: .65rem .75rem; width: 100%; min-width: 0; }
input:not([type=checkbox],[type=radio],[type=file]) { height: 3rem; }
textarea { display: block; resize: vertical; min-height: 10rem; margin-top: .5rem; }
input::placeholder,textarea::placeholder { font-family: var(--mono-font); color: var(--fg-muted); opacity: 1; }
.message-field { margin-block: 1.5rem; }
.field-error,.error-summary { font-size: .8125rem; color: var(--accent); margin: .4rem 0 0; }
.error-summary { margin-bottom: 1rem; }
.file-drop { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: .5rem; border: 1px dashed var(--fg-muted); min-height: 9rem; padding: 1rem; text-align: center; cursor: pointer; }
.file-drop:focus-within { outline: 2px solid var(--focus); outline-offset: 3px; }
.file-drop[data-drag] { border: 1px solid var(--accent); }
.file-drop :global(svg) { width: 2.5rem; height: 2.5rem; color: var(--accent); }
.file-drop strong { font-size: .9375rem; }
.file-drop > span { color: var(--fg-muted); font-size: .875rem; font-weight: 400; }
.file-list { padding: 0; list-style: none; font: .8125rem/1.6 var(--mono-font); }
.file-list :global(li) { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; overflow-wrap: anywhere; }
.file-list :global(button) { background: none; color: var(--accent); border: 0; min-width: 44px; min-height: 44px; }
.consent { display: grid; grid-template-columns: 1.25rem minmax(0,1fr) auto; gap: .75rem; margin-block: 1.5rem; }
.consent input { width: 1.25rem; height: 1.25rem; margin: .2rem 0 0; accent-color: var(--accent); }
.consent label { font-size: .9375rem; }
.consent p { font-size: .8125rem; color: var(--fg-muted); line-height: 1.6; margin: .5rem 0 0; }
.consent a { font-size: .8125rem; white-space: nowrap; }
.offline-notice { border: 1px solid var(--accent); padding: 1rem; }
.offline-notice p { margin: 0 0 1rem; font-size: .9375rem; }
.mail-button,.mail-link { display: none; width: 100%; min-height: 3.75rem; padding: .75rem; border: 1px solid var(--accent); background: var(--ink-950); color: var(--accent); font: 800 1.375rem/1.25 var(--display-font); text-align: center; text-decoration: none; }
:global(html.js) .mail-button,.mail-link { display: block; }
.mail-button:hover,.mail-link:hover { background: var(--surface); }
:global(html.js) .type-radios { display: none; }
.type-radios label { display: inline-flex; gap: .5rem; margin-right: 1rem; }
@media(max-width:639px) { .form-field { grid-template-columns: 1fr; gap: .25rem; } .consent { grid-template-columns: 1.25rem minmax(0,1fr); } .consent a { grid-column: 2; } }
</style>
